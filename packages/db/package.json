{
  "name": "@acceptance/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:dev": "node --env-file-if-exists=../../.env dist/cli/dev-postgres.js",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node --env-file-if-exists=../../.env dist/cli/seed.js"
  },
  "dependencies": {
    "@acceptance/checklist": "workspace:*",
    "@acceptance/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "6.19.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
