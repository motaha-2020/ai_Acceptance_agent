// Domain model for the Telecom Install Acceptance System (Phase 1).
// Conventions:
// - cuid() ids, timestamps with time zone, snake_case table names via @@map.
// - Enum values mirror packages/shared/src/enums.ts (single source of truth for the API contract).
// - Review and AuditLog are append-only (enforced by DB triggers in the init migration):
//   reviews are training labels for Phase 2 autonomy and must never be edited or deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── enums ─────────────────────────────

enum RoleName {
  admin
  pm
  reviewer
  engineer
  technician
  viewer
}

enum PhotoCategory {
  rack
  rack_base
  router
  patch_cords
  armoured_cables
  duct
  management
  odf_cross_connect
  odf_cross_connect_labels
  odf_tie
  odf_tie_labels
  odf_sheet
  uplink
  uplink_labels
  pdu
  power_path
  earth_path
  power_labels
  power_system
  test_room
}

enum PhotoStatus {
  captured
  uploaded
  ai_analyzed
  pending_review
  approved
  rejected
  fixed
}

/// ADR 0005: how a photo reached the system.
enum CaptureSource {
  camera
  web_bulk
  app_gallery
}

/// ADR 0005: whether Photo.category is final (bulk uploads: AI proposes, uploader confirms).
enum CategoryState {
  confirmed
  classifying
  proposed
}

enum SnagStatus {
  open
  fixed
  verified
}

enum SnagSource {
  ai
  human
}

enum Severity {
  minor
  major
  critical
}

enum ReviewDecision {
  agree
  override
  add_snag
}

enum Verdict {
  accept
  reject
  uncertain
}

enum VisitStatus {
  planned
  in_progress
  submitted
  closed
  cancelled
}

enum VisitType {
  installation
  snag_fix
  survey
}

enum SubmissionStatus {
  open
  submitted
}

enum AnalysisStatus {
  succeeded
  failed
}

enum ReportStatus {
  queued
  running
  ready
  failed
}

enum ReleaseChannel {
  production
  staging
}

enum CompanyKind {
  contractor
  client
  vendor
}

// ───────────────────────────── identity & access ─────────────────────────────

model Company {
  id        String      @id @default(cuid())
  name      String      @unique
  kind      CompanyKind @default(contractor)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  users     User[]
  projects  Project[]

  @@map("companies")
}

/// Roles are fixed (RoleName); the enforced policy lives in code (apps/api/src/auth/rbac).
/// Permission rows mirror that matrix so admins/UIs can display it.
model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  description String
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id         String  @id @default(cuid())
  roleId     String
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action     String
  subject    String
  /// Human-readable condition, e.g. "assigned visits only".
  conditions String?

  @@unique([roleId, action, subject])
  @@map("permissions")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens      RefreshToken[]
  assignments        VisitAssignment[] @relation("AssignedUser")
  assignmentsMade    VisitAssignment[] @relation("AssignedBy")
  visitsCreated      Visit[]
  photosUploaded     Photo[]           @relation("PhotoUploader")
  photosDecided      Photo[]           @relation("PhotoDecider")
  reviews            Review[]
  snagsCreated       Snag[]            @relation("SnagCreator")
  snagsVerified      Snag[]            @relation("SnagVerifier")
  snagsDismissed     Snag[]            @relation("SnagDismisser")
  reports            Report[]
  releases           AppRelease[]
  otaUpdates         OtaUpdate[]       @relation("OtaUpdateCreator")
  otaHeads           OtaChannelHead[]  @relation("OtaHeadUpdater")
  autonomyPolicyEdit AutonomyPolicy[]

  @@index([roleId])
  @@map("users")
}

/// Rotating refresh tokens. Only the SHA-256 of the opaque token is stored.
/// All tokens issued from one login share a familyId; presenting a revoked token revokes the family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────────────────────── projects, sites, devices ─────────────────────────────

model Project {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  clientName  String?
  description String?
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  sites       Site[]

  @@map("projects")
}

model Site {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  /// Stable human code, e.g. "nasr3-r21c".
  code       String    @unique
  name       String
  exchange   String?
  region     String?
  room       String?
  floor      String?
  racks      Int?
  gpsLat     Float?
  gpsLng     Float?
  /// Extra seed data (SID site data, LLD summary, ingest warnings).
  meta       Json?
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  devices  Device[]
  visits   Visit[]
  photos   Photo[]
  reports   Report[]
  bomLines  BOMLine[]
  technical SiteTechnicalData?

  @@index([projectId])
  @@map("sites")
}

model Device {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])
  model      String
  hostname   String?
  serial     String?
  loopbackIp String?
  role       String?
  meta       Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([siteId, hostname])
  @@index([serial])
  @@map("devices")
}

// ───────────────────────────── field work ─────────────────────────────

/// A visit (work order) to a site; technicians are assigned through VisitAssignment.
model Visit {
  id           String      @id @default(cuid())
  siteId       String
  site         Site        @relation(fields: [siteId], references: [id])
  title        String
  type         VisitType   @default(installation)
  status       VisitStatus @default(planned)
  scheduledFor DateTime?   @db.Timestamptz(3)
  startedAt    DateTime?   @db.Timestamptz(3)
  completedAt  DateTime?   @db.Timestamptz(3)
  notes        String?
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  assignments VisitAssignment[]
  submissions Submission[]
  photos      Photo[]

  @@index([siteId])
  @@index([status])
  @@map("visits")
}

model VisitAssignment {
  visitId      String
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("AssignedUser", fields: [userId], references: [id])
  assignedById String?
  assignedBy   User?    @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([visitId, userId])
  @@index([userId])
  @@map("visit_assignments")
}

model ChecklistTemplate {
  id        String          @id @default(cuid())
  category  PhotoCategory
  /// Checklist version (from @acceptance/checklist TAXONOMY_VERSION).
  version   String
  titleEn   String
  titleAr   String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  items     ChecklistItem[]

  @@unique([category, version])
  @@map("checklist_templates")
}

model ChecklistItem {
  id          String            @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Criterion id, e.g. RACK-01.
  code        String
  textEn      String
  textAr      String
  guardsCodes String[]
  sidRef      String?
  position    Int

  @@unique([templateId, code])
  @@map("checklist_items")
}

/// Photos of one category within a visit.
model Submission {
  id          String           @id @default(cuid())
  visitId     String
  visit       Visit            @relation(fields: [visitId], references: [id])
  category    PhotoCategory
  status      SubmissionStatus @default(open)
  submittedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  photos      Photo[]

  @@unique([visitId, category])
  @@map("submissions")
}

model Photo {
  id           String        @id @default(cuid())
  /// Generated on the device; makes offline-queue retries idempotent.
  clientUuid   String        @unique
  submissionId String
  submission   Submission    @relation(fields: [submissionId], references: [id])
  visitId      String
  visit        Visit         @relation(fields: [visitId], references: [id])
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id])
  category     PhotoCategory
  status       PhotoStatus   @default(uploaded)

  sha256      String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  originalKey String
  webKey      String
  thumbKey    String
  exif        Json?

  capturedAt  DateTime? @db.Timestamptz(3)
  gpsLat      Float?
  gpsLng      Float?
  gpsAccuracy Float?
  deviceInfo  Json?

  /// Same bytes were already uploaded as another photo (possible reuse of an old photo).
  duplicateOfId String?
  /// This photo is a re-shot that fixes snags of another photo.
  fixesPhotoId  String?
  /// Why AI analysis was skipped (budget_exceeded, analysis_failed, ...); the photo still goes to a human.
  aiSkipReason  String?

  captureSource       CaptureSource  @default(camera)
  uploadBatchId       String?
  /// Original file path/name for bulk uploads (category hint, provenance).
  fileName            String?
  categoryState       CategoryState  @default(confirmed)
  /// AI category proposal for bulk uploads (category holds the uploader's guess until confirmed).
  proposedCategory    PhotoCategory?
  proposedAlternative PhotoCategory?
  categoryConfidence  Float?

  uploadedById    String
  uploadedBy      User      @relation("PhotoUploader", fields: [uploadedById], references: [id])
  uploadedAt      DateTime  @default(now()) @db.Timestamptz(3)
  decidedById     String?
  decidedBy       User?     @relation("PhotoDecider", fields: [decidedById], references: [id])
  decidedAt       DateTime? @db.Timestamptz(3)
  rejectionReason String?
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  analyses Analysis[]
  snags    Snag[]     @relation("SnagPhoto")
  fixSnags Snag[]     @relation("SnagFixPhoto")
  reviews  Review[]

  @@index([status, category, uploadedAt])
  @@index([siteId])
  @@index([visitId])
  @@index([sha256])
  @@index([uploadBatchId])
  @@map("photos")
}

// ───────────────────────────── AI & review ─────────────────────────────

model Analysis {
  id               String         @id @default(cuid())
  photoId          String
  photo            Photo          @relation(fields: [photoId], references: [id])
  status           AnalysisStatus
  provider         String
  model            String
  promptVersion    String
  verdict          Verdict?
  confidence       Float?
  categoryMatches  Boolean?
  detectedCategory PhotoCategory?
  qualityIssues    String[]
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Decimal?       @db.Decimal(12, 6)
  latencyMs        Int?
  attempt          Int            @default(1)
  error            String?
  /// Raw provider result (validated or not) kept for audits and re-scoring.
  raw              Json?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  snags   Snag[]
  reviews Review[]

  @@index([photoId, createdAt])
  @@index([createdAt])
  @@map("analyses")
}

model Snag {
  id         String     @id @default(cuid())
  photoId    String
  photo      Photo      @relation("SnagPhoto", fields: [photoId], references: [id])
  analysisId String?
  analysis   Analysis?  @relation(fields: [analysisId], references: [id])
  /// Taxonomy code from @acceptance/checklist (e.g. LABEL_MISSING).
  code       String
  severity   Severity
  /// Normalised bbox {x,y,w,h} in 0..1.
  bbox       Json?
  textAr     String
  textEn     String
  status     SnagStatus @default(open)
  source     SnagSource

  createdById   String?
  createdBy     User?     @relation("SnagCreator", fields: [createdById], references: [id])
  /// Reviewer removed this (AI) snag as a false positive. Kept as a negative label.
  dismissedAt   DateTime? @db.Timestamptz(3)
  dismissedById String?
  dismissedBy   User?     @relation("SnagDismisser", fields: [dismissedById], references: [id])

  fixPhotoId   String?
  fixPhoto     Photo?    @relation("SnagFixPhoto", fields: [fixPhotoId], references: [id])
  fixedAt      DateTime? @db.Timestamptz(3)
  verifiedAt   DateTime? @db.Timestamptz(3)
  verifiedById String?
  verifiedBy   User?     @relation("SnagVerifier", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  reviews Review[]

  @@index([photoId])
  @@index([status, code])
  @@map("snags")
}

/// Human decision on a photo (and optionally a snag). These rows are the training labels
/// for Phase 2: append-only (DB trigger), never edited or deleted. Re-reviews add new rows.
model Review {
  id         String         @id @default(cuid())
  photoId    String
  photo      Photo          @relation(fields: [photoId], references: [id])
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  analysisId String?
  analysis   Analysis?      @relation(fields: [analysisId], references: [id])
  snagId     String?
  snag       Snag?          @relation(fields: [snagId], references: [id])
  decision   ReviewDecision
  /// Final human verdict for the photo.
  verdict    Verdict
  /// AI verdict at review time (denormalised for agreement metrics).
  aiVerdict  Verdict?
  category   PhotoCategory
  reason     String?
  /// {addedSnagIds, removedSnagIds, addedCodes, removedCodes, keptCodes}
  payload    Json?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([photoId, createdAt])
  @@index([category, createdAt])
  @@map("reviews")
}

/// Phase 2 autonomy gate. Phase 1: enabled=false everywhere -> every photo goes to a human.
model AutonomyPolicy {
  id            String        @id @default(cuid())
  category      PhotoCategory @unique
  minSamples    Int           @default(200)
  minAgreement  Float         @default(0.98)
  minConfidence Float         @default(0.9)
  enabled       Boolean       @default(false)
  updatedById   String?
  updatedBy     User?         @relation(fields: [updatedById], references: [id])
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@map("autonomy_policies")
}

// ───────────────────────────── reports & materials (stubs) ─────────────────────────────

/// Generated acceptance report (SID layout). Version increments per site; files live in object storage.
model Report {
  id          String       @id @default(cuid())
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id])
  version     Int
  status      ReportStatus @default(queued)
  /// Draft reports may be built while snags are open or photos are unreviewed (marked DRAFT).
  draft       Boolean      @default(false)
  docxKey     String?
  pdfKey      String?
  docxBytes   Int?
  pdfBytes    Int?
  error       String?
  /// Data-quality warnings found while building (cross-source checks, missing sections, no PDF).
  warnings    String[]     @default([])
  /// Build statistics: photo/snag counts, checklist summary, AI models and prompt versions.
  meta        Json?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?    @db.Timestamptz(3)
  finishedAt  DateTime?    @db.Timestamptz(3)

  @@unique([siteId, version])
  @@map("reports")
}

/// Per-site technical documents for the report (ADR 0004): typed JSON validated by
/// @acceptance/parsers SiteTechnical on every write and read. One row per site.
model SiteTechnicalData {
  siteId      String   @id
  site        Site     @relation(fields: [siteId], references: [id])
  siteData    Json?
  inventory   Json?
  lld         Json?
  portMap     Json?
  utilization Json?
  fiberTests  Json?
  /// Manual answers for non-photo checklist items, keyed by SID item id.
  survey      Json?
  /// Provenance of imported source files.
  sources     Json?
  /// Cross-source consistency warnings from the last import.
  warnings    String[] @default([])
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_technical_data")
}

model MaterialItem {
  id         String    @id @default(cuid())
  code       String    @unique
  nameEn     String
  nameAr     String?
  unit       String
  partNumber String?
  meta       Json?
  bomLines   BOMLine[]

  @@map("material_items")
}

model BOMLine {
  id             String        @id @default(cuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id])
  materialItemId String?
  materialItem   MaterialItem? @relation(fields: [materialItemId], references: [id])
  /// active | passive_power | telco_passive
  kind           String
  description    String
  partNumber     String?
  qty            Float?
  unit           String?
  serials        String[]
  /// Where the line came from (sid, inventory, manual).
  source         String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([siteId])
  @@map("bom_lines")
}

// ───────────────────────────── platform ─────────────────────────────

/// Append-only audit trail of every mutation (DB trigger blocks UPDATE/DELETE).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actorRole  String?
  action     String
  method     String
  path       String
  entity     String?
  entityId   String?
  before     Json?
  after      Json?
  statusCode Int
  requestId  String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Native mobile build (APK) published for download from the web portal (T5.5/T5.6).
/// "Latest" = newest published row per channel/platform by versionCode; unpublishing rolls back.
model AppRelease {
  id                      String         @id @default(cuid())
  platform                String         @default("android")
  version                 String
  /// Android versionCode; strictly increasing per platform.
  versionCode             Int            @default(0)
  channel                 ReleaseChannel
  /// expo-updates runtime version of this build (OTA bundles must match it).
  runtimeVersion          String
  apkKey                  String?
  apkSha256               String?
  apkSizeBytes            Int?
  bundleKey               String?
  /// Oldest app version still allowed to talk to the API (display form of minSupportedVersionCode).
  minSupported            String
  /// Builds with a lower versionCode are blocked by the app (forced update, T5.8).
  minSupportedVersionCode Int            @default(1)
  notes                   String?
  isCritical              Boolean        @default(false)
  publishedAt             DateTime?      @db.Timestamptz(3)
  createdById             String?
  createdBy               User?          @relation(fields: [createdById], references: [id])
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([version, channel])
  @@unique([platform, channel, versionCode])
  @@map("app_releases")
}

/// One over-the-air JS update (expo-updates protocol), exported by publish-ota.sh (T5.7).
/// Rows are immutable; which update a channel serves is decided by OtaChannelHead.
model OtaUpdate {
  /// Manifest id (UUID) the device stores; never reused.
  id             String         @id @db.Uuid
  channel        ReleaseChannel
  platform       String         @default("android")
  runtimeVersion String
  message        String?
  isCritical     Boolean        @default(false)
  /// {key, hash, contentType, fileExtension?, storageKey}
  launchAsset    Json
  /// [{key, hash, contentType, fileExtension, storageKey}]
  assets         Json
  /// Public app config served as manifest.extra.expoClient.
  expoClient     Json?
  gitCommit      String?
  createdById    String?
  createdBy      User?          @relation("OtaUpdateCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  heads OtaChannelHead[]

  @@index([channel, platform, runtimeVersion, createdAt])
  @@map("ota_updates")
}

/// What a channel serves for one runtime version: an update, or "roll back to the embedded bundle".
/// Publishing moves the head forward; rollback points it to an earlier update.
model OtaChannelHead {
  channel            ReleaseChannel
  platform           String
  runtimeVersion     String
  updateId           String?        @db.Uuid
  update             OtaUpdate?     @relation(fields: [updateId], references: [id])
  rollBackToEmbedded Boolean        @default(false)
  updatedById        String?
  updatedBy          User?          @relation("OtaHeadUpdater", fields: [updatedById], references: [id])
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  @@id([channel, platform, runtimeVersion])
  @@map("ota_channel_heads")
}
