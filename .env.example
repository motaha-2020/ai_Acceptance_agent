# ───────────── Database (PostgreSQL 16) ─────────────
# Local without Docker: `pnpm --filter @acceptance/db db:dev` starts embedded PostgreSQL with these credentials.
DATABASE_URL=postgresql://acceptance:acceptance@localhost:5432/acceptance

# ───────────── Queue ─────────────
# Unset = in-process queue; the API then runs the analysis worker itself (local dev without Redis).
# Production (docker compose): set it and run apps/worker as a separate process.
# REDIS_URL=redis://localhost:6379
# QUEUE_PREFIX=acceptance
# EMBEDDED_WORKER=auto          # auto | true | false

# ───────────── Object storage ─────────────
# local = filesystem + HMAC-signed URLs served by the API (dev); s3 = MinIO/S3 (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# >= 32 chars; signs local download URLs
STORAGE_SIGNING_SECRET=change-me-to-a-random-string-of-32-chars-or-more
S3_ENDPOINT=http://localhost:9000
# Host clients use to download (presigned URLs), e.g. https://files.example.com
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=photos

# ───────────── API ─────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated origins allowed by CORS (web portal)
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-chars-or-more
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh tokens are opaque random strings stored hashed (no signing secret needed).
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_MAX_BYTES=26214400
SIGNED_URL_TTL_SECONDS=900

# ───────────── Seed (pnpm --filter @acceptance/db db:seed) ─────────────
SEED_ADMIN_EMAIL=admin@acceptance.local
# Required, >= 10 chars. Only used when the admin user is created.
SEED_ADMIN_PASSWORD=
# SITE_SEED_PATH=data/sites/nasr3-r21c.json

# ───────────── AI analysis (worker) ─────────────
# Registered provider name; `fake` (always accepts) is for dev/tests and refused in production.
AI_PROVIDER=fake
AI_CONCURRENCY=2
AI_MAX_ATTEMPTS=3
# USD per UTC day; when spent, photos go to human review without AI. 0 disables the guard.
AI_DAILY_BUDGET_USD=20
# Phase 2 only. Phase 1 keeps every photo in human review.
AUTONOMY_ENABLED=false

# AI providers (bake-off: set the ones you want to test)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: JSON file overriding token prices in packages/ai/src/pricing.ts (verify vendor pricing pages)
AI_PRICES_FILE=
