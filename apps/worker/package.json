{
  "name": "@acceptance/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@acceptance/checklist": "workspace:*",
    "@acceptance/db": "workspace:*",
    "@acceptance/queue": "workspace:*",
    "@acceptance/shared": "workspace:*",
    "@acceptance/storage": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "sharp": "^0.34.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
