{
  "name": "@acceptance/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=../../.env dist/main.js",
    "openapi": "node dist/cli/openapi.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@acceptance/checklist": "workspace:*",
    "@acceptance/db": "workspace:*",
    "@acceptance/queue": "workspace:*",
    "@acceptance/shared": "workspace:*",
    "@acceptance/storage": "workspace:*",
    "@acceptance/worker": "workspace:*",
    "@casl/ability": "^6.7.0",
    "@casl/prisma": "^1.5.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "exifr": "^7.1.3",
    "fastify": "5.11.3",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
